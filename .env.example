# Cadena de conexión MySQL (local o remota: PlanetScale, Railway, AWS RDS, etc.)
DATABASE_URL="mysql://root:password@localhost:3306/tienda_ev"

# Auth.js — genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_TRUST_HOST=true

# Credenciales del administrador inicial creado por el seed
SEED_ADMIN_EMAIL="tu-email@dominio.com"
SEED_ADMIN_PASSWORD="pon-una-contrasena-segura-aqui"
