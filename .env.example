# Cadena de conexión MySQL (local o remota: PlanetScale, Railway, AWS RDS, etc.)
DATABASE_URL="mysql://root:password@localhost:3306/tienda_ev"

# Auth.js — genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
AUTH_TRUST_HOST=true

# Credenciales del administrador inicial creado por el seed
SEED_ADMIN_EMAIL="admin@tienda-ev.com"
SEED_ADMIN_PASSWORD="Admin123!"

# URL pública de la tienda (enlaces en los correos)
APP_URL="http://localhost:3000"

# Correo SMTP (opcional). Sin SMTP_HOST, los correos se guardan como HTML en storage/emails/
# Ejemplos: smtp.gmail.com:587 (contraseña de aplicación), smtp-relay.brevo.com:587, smtp.resend.com:465
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EMC Positive Energy <no-reply@emc-positive.com>"

# Carpeta de imágenes subidas desde el admin (por defecto ./storage/uploads)
# UPLOAD_DIR="storage/uploads"

# Google Cloud Storage para imágenes subidas (producción en Cloud Run). Vacío = disco local
GCS_BUCKET=""

# Wompi (pasarela de pagos: tarjeta, PSE, Nequi). Sin estas llaves el checkout usa el pago simulado.
# Llaves en comercios.wompi.co → Desarrolladores. Prefijo pub_test_ = sandbox, pub_prod_ = producción.
# URL de eventos a registrar en Wompi: {APP_URL}/api/webhooks/wompi
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# Secreto del endpoint /api/cron/expire-orders (cancela pedidos sin pagar tras 2 h). openssl rand -base64 32
CRON_SECRET=""
